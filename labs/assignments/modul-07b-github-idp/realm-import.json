{
  "id": "mustertech",
  "realm": "mustertech",
  "displayName": "Mustertech GmbH",
  "displayNameHtml": "<b>Mustertech</b> GmbH",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "rememberMe": true,
  "bruteForceProtected": false,
  "defaultSignatureAlgorithm": "RS256",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "accessCodeLifespan": 60,
  "accessCodeLifespanLogin": 1800,
  "roles": {
    "realm": [
      {
        "name": "default-roles-mustertech",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": [
            "offline_access",
            "uma_authorization"
          ]
        }
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}"
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}"
      },
      {
        "name": "mitarbeiter",
        "description": "Basis-Rolle für alle Mitarbeiter der Mustertech GmbH"
      },
      {
        "name": "manager",
        "description": "Manager mit erweiterten Rechten (z.B. Urlaubsgenehmigung)",
        "composite": true,
        "composites": {
          "realm": [
            "mitarbeiter"
          ]
        }
      },
      {
        "name": "admin",
        "description": "Administrator mit vollen Zugriffsrechten",
        "composite": true,
        "composites": {
          "realm": [
            "manager"
          ]
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-mustertech",
    "description": "${role_default-roles}",
    "composite": true
  },
  "groups": [
    {
      "name": "Entwicklung",
      "attributes": {
        "abteilung": [
          "Entwicklung"
        ]
      },
      "realmRoles": [
        "mitarbeiter"
      ]
    },
    {
      "name": "Vertrieb",
      "attributes": {
        "abteilung": [
          "Vertrieb"
        ]
      },
      "realmRoles": [
        "mitarbeiter"
      ]
    },
    {
      "name": "Management",
      "attributes": {
        "abteilung": [
          "Management"
        ]
      },
      "realmRoles": [
        "manager"
      ]
    }
  ],
  "users": [
    {
      "username": "hans.mueller",
      "enabled": true,
      "email": "hans.mueller@mustertech.de",
      "firstName": "Hans",
      "lastName": "Müller",
      "emailVerified": true,
      "attributes": {
        "personalnummer": [
          "M-1001"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "test1234",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-mustertech"
      ],
      "groups": [
        "Entwicklung"
      ]
    },
    {
      "username": "anna.schmidt",
      "enabled": true,
      "email": "anna.schmidt@mustertech.de",
      "firstName": "Anna",
      "lastName": "Schmidt",
      "emailVerified": true,
      "attributes": {
        "personalnummer": [
          "M-1002"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "test1234",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-mustertech"
      ],
      "groups": [
        "Vertrieb"
      ]
    },
    {
      "username": "max.admin",
      "enabled": true,
      "email": "max.admin@mustertech.de",
      "firstName": "Max",
      "lastName": "Administrator",
      "emailVerified": true,
      "attributes": {
        "personalnummer": [
          "M-0001"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "test1234",
          "temporary": false
        }
      ],

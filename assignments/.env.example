# ============================================
# Keycloak Schulung - Umgebungsvariablen
# ============================================
# Kopieren Sie diese Datei nach .env und passen Sie die Werte an.
# cp .env.example .env

# --------------------------------------------
# PostgreSQL Datenbank
# --------------------------------------------
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=keycloak_db_password

# --------------------------------------------
# Keycloak
# --------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Datenbank-Verbindung (verwendet die obigen Werte)
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=keycloak_db_password

# Hostname-Konfiguration
KC_HOSTNAME=localhost
KC_HOSTNAME_PORT=8080
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_HTTPS=false

# HTTP (nur für Entwicklung!)
KC_HTTP_ENABLED=true

# --------------------------------------------
# GitHub OAuth (Modul 08)
# --------------------------------------------
# Diese Werte erhalten Sie vom Trainer
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --------------------------------------------
# Portal Frontend (Modul 07+)
# --------------------------------------------
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=mustertech
VITE_KEYCLOAK_CLIENT_ID=portal-frontend

# --------------------------------------------
# Portal API (Modul 09+)
# --------------------------------------------
API_PORT=3001
API_KEYCLOAK_URL=http://localhost:8080
API_KEYCLOAK_REALM=mustertech
